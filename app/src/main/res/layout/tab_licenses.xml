<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <GridView
        android:id="@+id/list_licenses"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:numColumns="1"
        android:drawSelectorOnTop="true"
        android:listSelector="@drawable/sel_card"
        android:paddingTop="60dp"
        android:paddingBottom="88dp"
        android:scrollbars="none" />

    <Spinner
        android:id="@+id/sp_month"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/empty_licenses"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="هنوز لایسنسی صادر نشده است"
        android:textColor="?android:attr/textColorSecondary" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_issue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="صدور لایسنس"
        android:text="صدور لایسنس"
        app:icon="@drawable/ic_key" />
</FrameLayout>
